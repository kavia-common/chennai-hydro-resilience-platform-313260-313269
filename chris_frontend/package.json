{
  "name": "chris-frontend",
  "version": "0.1.0",
  "private": true,
  "homepage": "/proxy/3000",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.5.1",
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.6.5",
    "leaflet": "^1.9.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^6.21.1",
    "react-scripts": "^5.0.1",
    "recharts": "^2.10.3",
    "zustand": "^4.4.7"
  },
  "scripts": {
    "start": "HOST=0.0.0.0 PORT=3000 GENERATE_SOURCEMAP=true BROWSER=none DANGEROUSLY_DISABLE_HOST_CHECK=true WDS_SOCKET_PATH=/proxy/3000/ws PUBLIC_URL=/proxy/3000 react-app-rewired start",

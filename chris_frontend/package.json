{
  "name": "chris-frontend",
  "version": "0.1.0",
  "private": true,
  "homepage": "/proxy/3000",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.5.1",
    "@fortawesome/free-solid-svg-icons": "^6.5.1",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@supabase/supabase-js": "^2.39.0",
    "axios": "^1.6.5",
    "framer-motion": "^11.0.0",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.21.1",
    "react-scripts": "5.0.1",
    "recharts": "^2.10.3",
    "zustand": "^4.4.7"
  },
  "scripts": {
    "start": "HOST=0.0.0.0 PORT=3000 GENERATE_SOURCEMAP=true BROWSER=none DANGEROUSLY_DISABLE_HOST_CHECK=true WDS_SOCKET_PATH=/proxy/3000/ws PUBLIC_URL=/proxy/3000 react-app-rewired start",
    "build": "react-app-rewired build",
    "test": "CI=true react-app-rewired test",
    "eject": "react-scripts eject",
    "clean": "rm -rf node_modules/.cache build",
    "restart": "npm run clean && npm start",
    "validate-api": "bash validate-api-setup.sh",
    "check-health": "curl -s ${REACT_APP_API_BASE:-http://localhost:3001}/api/v1/health | json_pp"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.5.1",
    "cross-env": "^7.0.3",
    "react-app-rewired": "^2.2.1"
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!(react-leaflet|@react-leaflet)/)"
    ],
    "moduleNameMapper": {
      "^leaflet$": "<rootDir>/src/__mocks__/leaflet.js",
      "^react-leaflet$": "<rootDir>/src/__mocks__/react-leaflet.js",
      "\\.(css|less|scss|sass)$": "<rootDir>/src/__mocks__/styleMock.js"
    }
  }
}

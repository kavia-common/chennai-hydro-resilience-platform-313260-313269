# Development-specific environment variables
# These override .env values in development mode

# PUBLIC_URL for proxied access - CRA uses this for webpack public path
# CRITICAL: This must NOT have REACT_APP_ prefix (it's a webpack variable)
PUBLIC_URL=/proxy/3000

# WebSocket path for HMR (Hot Module Replacement) through proxy
WDS_SOCKET_PATH=/proxy/3000/ws

# Disable host check for proxied access (safe in dev behind proxy)
DANGEROUSLY_DISABLE_HOST_CHECK=true

# Dev server port
PORT=3000

# CRITICAL: Bind to all network interfaces so proxy can reach the dev server
HOST=0.0.0.0

# Disable webpack content hash in dev mode (helps with cache issues)
GENERATE_SOURCEMAP=true

# Enable Fast Refresh
FAST_REFRESH=true

# Disable browser auto-open
BROWSER=none

# Public URL Configuration
# IMPORTANT: Set this when the app is served behind a reverse proxy
# For proxy at /proxy/3000, use: PUBLIC_URL=/proxy/3000
# For root deployment, leave empty or use: PUBLIC_URL=/
PUBLIC_URL=/proxy/3000

# Supabase Configuration
# Get these from your Supabase dashboard: https://app.supabase.com/project/_/settings/api
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_KEY=your-anon-key

# Backend API Configuration
# Point to your FastAPI backend server
REACT_APP_BACKEND_URL=http://localhost:3001

# Frontend Configuration
# Used for Supabase email redirects (set to your deployment URL in production)
REACT_APP_FRONTEND_URL=http://localhost:3000

# WebSocket URL (if using WebSocket features in the future)
REACT_APP_WS_URL=ws://localhost:3001/ws

# Environment
REACT_APP_NODE_ENV=development

# Optional: Feature flags and other configurations
REACT_APP_NEXT_TELEMETRY_DISABLED=1
REACT_APP_ENABLE_SOURCE_MAPS=true
REACT_APP_PORT=3000
REACT_APP_LOG_LEVEL=info
